{
  "name": "whatsapp-order-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot for order taking with NLP product matching",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "eval": "tsx scripts/evaluate-nlp.ts"
  },
  "keywords": ["whatsapp", "bot", "orders", "nlp", "baileys"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "fast-levenshtein": "^3.0.0",
    "uuid": "^9.0.0",
    "wink-nlp": "^1.14.3",
    "wink-eng-lite-web-model": "^1.0.0"
  },
  "devDependencies": {
    
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}