# WhatsApp Order Bot Configuration

# Catalog file path (JSON format)
CATALOG_PATH=./data/catalog.json

# Orders directory (JSONL files, one per day: YYYY-MM-DD.jsonl)
ORDERS_DIR=./orders

# Admin WhatsApp numbers (comma-separated, with country code, no + or spaces)
# Example: 5215512345678,5215587654321
ADMIN_NUMBERS=5215512345678

# Session TTL in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# Matching thresholds
# Accept threshold: score >= this value auto-accepts match
MATCH_ACCEPT=0.75
# Clarify threshold: score >= this value triggers clarification prompt
MATCH_CLARIFY=0.50